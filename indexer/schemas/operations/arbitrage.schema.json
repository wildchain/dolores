{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clu-protocol.com/schemas/operations/arbitrage/v1.0.0",
  "title": "Arbitrage Operation Details",
  "description": "Multi-DEX arbitrage operation",
  "type": "object",
  "required": ["dex_programs", "trades", "net_profit_usdc", "gas_fee_usdc"],
  "properties": {
    "dex_programs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 32,
        "maxLength": 64
      },
      "minItems": 2,
      "description": "DEX programs used in arbitrage"
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dex",
          "input_token",
          "output_token",
          "input_amount",
          "output_amount"
        ],
        "properties": {
          "dex": {
            "type": "string"
          },
          "input_token": {
            "type": "string"
          },
          "output_token": {
            "type": "string"
          },
          "input_amount": {
            "type": "integer"
          },
          "output_amount": {
            "type": "integer"
          }
        }
      },
      "minItems": 2,
      "description": "Sequence of trades executed"
    },
    "net_profit_usdc": {
      "type": "number",
      "description": "Net profit in USDC after all trades and fees"
    },
    "gas_fee_usdc": {
      "type": "number",
      "minimum": 0,
      "description": "Total gas fees in USDC"
    },
    "profit_percentage": {
      "type": "number",
      "description": "Profit as percentage of initial capital"
    },
    "route": {
      "type": "string",
      "description": "Human-readable arbitrage route (e.g., 'SOL -> USDC (Jupiter) -> SOL (Orca)')"
    }
  }
}
