{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clu-protocol.com/schemas/operations/remove_liquidity/v1.0.0",
  "title": "Remove Liquidity Operation Details",
  "description": "AMM liquidity withdrawal operation",
  "type": "object",
  "required": [
    "pool_program",
    "pool_address",
    "lp_token_mint",
    "lp_token_amount",
    "token_a_mint",
    "token_b_mint",
    "token_a_received",
    "token_b_received",
    "min_token_a",
    "min_token_b"
  ],
  "properties": {
    "pool_program": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "pool_address": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "lp_token_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "lp_token_amount": {
      "type": "integer",
      "minimum": 1,
      "description": "Amount of LP tokens burned"
    },
    "token_a_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "token_b_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "token_a_received": {
      "type": "integer",
      "minimum": 1
    },
    "token_b_received": {
      "type": "integer",
      "minimum": 1
    },
    "min_token_a": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum Token A acceptable (slippage protection)"
    },
    "min_token_b": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum Token B acceptable (slippage protection)"
    },
    "withdrawal_fee_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Withdrawal fee in basis points (if applicable)"
    }
  }
}
