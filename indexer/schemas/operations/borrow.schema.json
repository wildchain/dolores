{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clu-protocol.com/schemas/operations/borrow/v1.0.0",
  "title": "Borrow Operation Details",
  "description": "Lending protocol borrow operation",
  "type": "object",
  "required": [
    "lending_program",
    "lending_pool",
    "position_address",
    "collateral_mint",
    "collateral_amount",
    "borrow_mint",
    "borrow_amount",
    "collateral_ratio",
    "interest_rate"
  ],
  "properties": {
    "lending_program": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64,
      "description": "Lending protocol program ID (Solend, MarginFi, etc.)"
    },
    "lending_pool": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "position_address": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64,
      "description": "User's lending position account"
    },
    "collateral_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "collateral_amount": {
      "type": "integer",
      "minimum": 1,
      "description": "Total collateral amount after this borrow"
    },
    "borrow_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "borrow_amount": {
      "type": "integer",
      "minimum": 1
    },
    "collateral_ratio": {
      "type": "number",
      "minimum": 100,
      "description": "Collateral ratio percentage (e.g., 150 = 150%)"
    },
    "interest_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Annual interest rate percentage"
    },
    "liquidation_threshold": {
      "type": "number",
      "minimum": 100,
      "maximum": 200,
      "description": "Health factor threshold for liquidation"
    },
    "health_factor": {
      "type": "number",
      "minimum": 0,
      "description": "Position health factor after borrow"
    }
  }
}
