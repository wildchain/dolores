{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clu-protocol.com/schemas/operations/flash_loan/v1.0.0",
  "title": "Flash Loan Operation Details",
  "description": "Flash loan operation - must be repaid in same transaction",
  "type": "object",
  "required": [
    "protocol_program",
    "protocol_address",
    "loan_mint",
    "loan_amount",
    "fee_paid",
    "repaid_in_same_tx"
  ],
  "properties": {
    "protocol_program": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64,
      "description": "Flash loan provider program ID"
    },
    "protocol_address": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "loan_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "loan_amount": {
      "type": "integer",
      "minimum": 1
    },
    "fee_paid": {
      "type": "integer",
      "minimum": 0,
      "description": "Fee paid for flash loan"
    },
    "fee_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Fee in basis points"
    },
    "repaid_in_same_tx": {
      "type": "boolean",
      "const": true,
      "description": "MUST be true - flash loans must be repaid in same tx"
    },
    "net_profit": {
      "type": "integer",
      "description": "Net profit after loan repayment (can be negative)"
    }
  }
}
