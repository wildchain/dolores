{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clu-protocol.com/schemas/operations/liquidate/v1.0.0",
  "title": "Liquidate Operation Details",
  "description": "Liquidation of underwater lending position",
  "type": "object",
  "required": [
    "lending_protocol",
    "target_position",
    "target_owner",
    "collateral_mint",
    "collateral_seized",
    "debt_mint",
    "debt_repaid",
    "liquidation_bonus",
    "pre_liquidation_health_factor"
  ],
  "properties": {
    "lending_protocol": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "target_position": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64,
      "description": "Liquidated position account address"
    },
    "target_owner": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64,
      "description": "Owner of liquidated position"
    },
    "collateral_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "collateral_seized": {
      "type": "integer",
      "minimum": 1,
      "description": "Amount of collateral seized by liquidator"
    },
    "debt_mint": {
      "type": "string",
      "minLength": 32,
      "maxLength": 64
    },
    "debt_repaid": {
      "type": "integer",
      "minimum": 1,
      "description": "Amount of debt repaid"
    },
    "liquidation_bonus": {
      "type": "number",
      "minimum": 0,
      "maximum": 50,
      "description": "Liquidation bonus percentage received"
    },
    "pre_liquidation_health_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Health factor of position BEFORE liquidation (must be < 1)"
    },
    "liquidator_profit_usdc": {
      "type": "number",
      "minimum": 0,
      "description": "Profit in USDC equivalent"
    }
  }
}
