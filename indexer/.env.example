# Arweave Configuration
# Best practice for production: Use ARWEAVE_WALLET_JSON environment variable
# For development: Generate a wallet and fund it with testnet AR

# Option 1: Wallet from file path (local development)
# ARWEAVE_WALLET_PATH=./arweave-wallet.json

# Option 2: Wallet from JSON string (production - use secrets manager)
# ARWEAVE_WALLET_JSON='{"kty":"RSA","n":"...","e":"AQAB",...}'

# Arweave network configuration
ARWEAVE_HOST=arweave.net
ARWEAVE_PORT=443
ARWEAVE_PROTOCOL=https


