# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com

# CORS
CORS_ORIGIN=http://localhost:5173

# IPFS (Helia in-process node)
# Directory where the Helia IPFS node stores its persistent blockstore.
# Defaults to ./data/ipfs relative to the working directory if not set.
# The directory is created automatically on first run.
IPFS_DATA_DIR=./data/ipfs
