# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com

# CORS
CORS_ORIGIN=http://localhost:5173

# IPFS (standalone apps/ipfs service)
# URL of the apps/ipfs Fastify+Helia microservice.
# Start it with: pnpm dev:ipfs
IPFS_NODE_URL=http://localhost:3002

# Public IPFS gateway used to fetch stored manifests (for display/read).
# Defaults to https://ipfs.io/ipfs if not set.
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
