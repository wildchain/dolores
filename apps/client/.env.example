# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8545

# IPFS Gateway (used to fetch execution receipts for attestation details)
# Local dev (apps/ipfs Helia node): http://localhost:3002/get
# Production / public gateway:      https://ipfs.io/ipfs
NEXT_PUBLIC_IPFS_GATEWAY_URL=http://localhost:3002/get

# Solana Network Configuration
# Options: 'mainnet-beta', 'testnet', 'devnet'
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional: Custom RPC endpoint (if not provided, uses default cluster URL)
# NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
