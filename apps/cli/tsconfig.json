{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "outDir": "./dist",
        "rootDir": ".",
        "strict": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "composite": true
    },
    "references": [
        {
            "path": "../../packages/shared"
        },
        {
            "path": "../../packages/contracts"
        },
        {
            "path": "../../packages/solana-utils"
        }
    ],
    "include": [
        "src/**/*",
        "src/**/*.json"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}